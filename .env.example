# RepoFixLab secrets and runtime endpoints. Copy to .env and fill locally.
ZHIPU_API_KEY=
REPOFIX_CONTROLLER_URL=http://controller:8000
REPOFIX_ARTIFACTS_PATH=/artifacts

# Dataset preparation. The wrapper sets generation-scoped volume names and the
# immutable local image ID before running the one-shot Compose profile.
REPOFIX_PREPARER_IMAGE_ID=
REPOFIX_DATASET_SOURCE_VOLUME=repofixlab-dataset-source
REPOFIX_PUBLIC_VOLUME=dataset-public-unconfigured
REPOFIX_CONTROL_VOLUME=dataset-control-unconfigured
REPOFIX_PRIVATE_VOLUME=dataset-private-unconfigured
