# Default to LF for text files across the repo
* text=auto eol=lf

# Preserve hash-sealed M0 evidence bytes exactly
docs/evidence/repofixlab-m0/*.json -text whitespace=cr-at-eol

# Preserve frozen unified-diff bytes, including required context whitespace
packages/repofixlab/configs/benchmarks/docker-v1/*.patch -text -whitespace

# Windows scripts should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts should keep LF
*.sh text eol=lf

# Common binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
