{
	"$id": "urn:repofixlab:schema:v1:patch-snapshot",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"additionalProperties": false,
	"properties": {
		"attempt_id": {
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$",
			"type": "string"
		},
		"base_commit": {
			"pattern": "^[a-f0-9]{40}$",
			"type": "string"
		},
		"base_tree": {
			"additionalProperties": false,
			"properties": {
				"algorithm": {
					"const": "git-sha1",
					"type": "string"
				},
				"value": {
					"pattern": "^[a-f0-9]{40}$",
					"type": "string"
				}
			},
			"required": [
				"algorithm",
				"value"
			],
			"type": "object"
		},
		"candidate_tree": {
			"additionalProperties": false,
			"properties": {
				"algorithm": {
					"const": "git-sha1",
					"type": "string"
				},
				"value": {
					"pattern": "^[a-f0-9]{40}$",
					"type": "string"
				}
			},
			"required": [
				"algorithm",
				"value"
			],
			"type": "object"
		},
		"created_at": {
			"maxLength": 64,
			"minLength": 20,
			"pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$",
			"type": "string"
		},
		"files": {
			"items": {
				"additionalProperties": false,
				"properties": {
					"path": {
						"pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
						"type": "string"
					},
					"status": {
						"anyOf": [
							{
								"const": "added",
								"type": "string"
							},
							{
								"const": "modified",
								"type": "string"
							},
							{
								"const": "deleted",
								"type": "string"
							},
							{
								"const": "renamed",
								"type": "string"
							}
						]
					}
				},
				"required": [
					"path",
					"status"
				],
				"type": "object"
			},
			"maxItems": 1000,
			"type": "array"
		},
		"label": {
			"anyOf": [
				{
					"const": "candidate",
					"type": "string"
				},
				{
					"const": "P0",
					"type": "string"
				},
				{
					"const": "P1",
					"type": "string"
				}
			]
		},
		"patch_bytes": {
			"maximum": 2097152,
			"minimum": 0,
			"type": "integer"
		},
		"patch_sha256": {
			"pattern": "^[a-f0-9]{64}$",
			"type": "string"
		},
		"policy": {
			"additionalProperties": false,
			"properties": {
				"status": {
					"anyOf": [
						{
							"const": "pass",
							"type": "string"
						},
						{
							"const": "fail",
							"type": "string"
						}
					]
				},
				"violations": {
					"items": {
						"maxLength": 500,
						"minLength": 1,
						"type": "string"
					},
					"maxItems": 100,
					"type": "array"
				}
			},
			"required": [
				"status",
				"violations"
			],
			"type": "object"
		},
		"run_id": {
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$",
			"type": "string"
		},
		"schema_version": {
			"const": "v1",
			"type": "string"
		},
		"snapshot_id": {
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$",
			"type": "string"
		},
		"snapshot_sha256": {
			"pattern": "^[a-f0-9]{64}$",
			"type": "string"
		},
		"snapshot_type": {
			"const": "patch",
			"type": "string"
		}
	},
	"required": [
		"schema_version",
		"snapshot_type",
		"snapshot_id",
		"run_id",
		"attempt_id",
		"label",
		"base_commit",
		"base_tree",
		"candidate_tree",
		"patch_sha256",
		"patch_bytes",
		"files",
		"policy",
		"created_at",
		"snapshot_sha256"
	],
	"type": "object"
}
