{
	"$id": "urn:repofixlab:schema:v1:run-manifest",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"additionalProperties": false,
	"properties": {
		"budget": {
			"additionalProperties": false,
			"properties": {
				"accounted_admission_cap_tokens": {
					"anyOf": [
						{
							"minimum": 1,
							"type": "integer"
						},
						{
							"type": "null"
						}
					]
				},
				"max_model_turns": {
					"minimum": 1,
					"type": "integer"
				},
				"max_tool_calls": {
					"minimum": 1,
					"type": "integer"
				},
				"max_wall_time_ms": {
					"minimum": 1,
					"type": "integer"
				}
			},
			"required": [
				"accounted_admission_cap_tokens",
				"max_model_turns",
				"max_tool_calls",
				"max_wall_time_ms"
			],
			"type": "object"
		},
		"config_id": {
			"anyOf": [
				{
					"const": "pi-general",
					"type": "string"
				},
				{
					"const": "repofix-full",
					"type": "string"
				},
				{
					"const": "repofix-no-localize",
					"type": "string"
				},
				{
					"const": "repofix-no-verify-feedback",
					"type": "string"
				}
			]
		},
		"created_at": {
			"maxLength": 64,
			"minLength": 20,
			"pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$",
			"type": "string"
		},
		"experiment_id": {
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$",
			"type": "string"
		},
		"instance_id": {
			"maxLength": 200,
			"minLength": 1,
			"type": "string"
		},
		"manifest_id": {
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$",
			"type": "string"
		},
		"manifest_sha256": {
			"pattern": "^[a-f0-9]{64}$",
			"type": "string"
		},
		"manifest_type": {
			"const": "run_manifest",
			"type": "string"
		},
		"model": {
			"additionalProperties": false,
			"properties": {
				"model_id": {
					"const": "glm-4.5-air",
					"type": "string"
				},
				"model_spec_sha256": {
					"pattern": "^[a-f0-9]{64}$",
					"type": "string"
				},
				"pricing_spec_sha256": {
					"pattern": "^[a-f0-9]{64}$",
					"type": "string"
				},
				"provider": {
					"const": "zhipu-standard",
					"type": "string"
				},
				"system_prompt_sha256": {
					"pattern": "^[a-f0-9]{64}$",
					"type": "string"
				},
				"tool_schema_sha256": {
					"pattern": "^[a-f0-9]{64}$",
					"type": "string"
				}
			},
			"required": [
				"provider",
				"model_id",
				"model_spec_sha256",
				"pricing_spec_sha256",
				"system_prompt_sha256",
				"tool_schema_sha256"
			],
			"type": "object"
		},
		"public_task_manifest_id": {
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$",
			"type": "string"
		},
		"public_task_manifest_sha256": {
			"pattern": "^[a-f0-9]{64}$",
			"type": "string"
		},
		"replicate": {
			"minimum": 1,
			"type": "integer"
		},
		"run_id": {
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$",
			"type": "string"
		},
		"schema_version": {
			"const": "v1",
			"type": "string"
		},
		"task_environment_lock_id": {
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$",
			"type": "string"
		},
		"task_environment_lock_sha256": {
			"pattern": "^[a-f0-9]{64}$",
			"type": "string"
		}
	},
	"required": [
		"schema_version",
		"manifest_type",
		"manifest_id",
		"experiment_id",
		"run_id",
		"config_id",
		"instance_id",
		"replicate",
		"public_task_manifest_id",
		"public_task_manifest_sha256",
		"task_environment_lock_id",
		"task_environment_lock_sha256",
		"model",
		"budget",
		"created_at",
		"manifest_sha256"
	],
	"type": "object"
}
