{
	"$id": "urn:repofixlab:schema:v1:pristine-runtime-lock",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"additionalProperties": false,
	"properties": {
		"created_at": {
			"maxLength": 64,
			"minLength": 1,
			"type": "string"
		},
		"image": {
			"additionalProperties": false,
			"properties": {
				"base_image": {
					"anyOf": [
						{
							"pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$",
							"type": "string"
						},
						{
							"pattern": "^sha256:[a-f0-9]{64}$",
							"type": "string"
						}
					]
				},
				"cmd": {
					"items": {
						"const": "self-check",
						"type": "string"
					},
					"maxItems": 1,
					"minItems": 1,
					"type": "array"
				},
				"configured_user": {
					"const": "65532:65532",
					"type": "string"
				},
				"created_at": {
					"maxLength": 64,
					"minLength": 1,
					"type": "string"
				},
				"entrypoint": {
					"items": {
						"anyOf": [
							{
								"const": "python",
								"type": "string"
							},
							{
								"const": "-m",
								"type": "string"
							},
							{
								"const": "repofixlab_evaluator.pristine_runtime",
								"type": "string"
							}
						]
					},
					"maxItems": 3,
					"minItems": 3,
					"type": "array"
				},
				"id": {
					"pattern": "^sha256:[a-f0-9]{64}$",
					"type": "string"
				},
				"labels": {
					"additionalProperties": false,
					"properties": {
						"io.repofixlab.harness.mode": {
							"const": "pristine",
							"type": "string"
						},
						"io.repofixlab.provenance.sha256": {
							"pattern": "^[a-f0-9]{64}$",
							"type": "string"
						},
						"org.opencontainers.image.revision": {
							"const": "726c5461e2ef52d83cf1ea2107870a8bb3328d57",
							"type": "string"
						},
						"org.opencontainers.image.title": {
							"const": "RepoFixLab pristine SWE-bench harness",
							"type": "string"
						}
					},
					"required": [
						"io.repofixlab.harness.mode",
						"io.repofixlab.provenance.sha256",
						"org.opencontainers.image.revision",
						"org.opencontainers.image.title"
					],
					"type": "object"
				},
				"oracle_runtime_user": {
					"const": "0:0",
					"type": "string"
				},
				"platform": {
					"const": "linux/amd64",
					"type": "string"
				},
				"repo_digest": {
					"pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$",
					"type": "string"
				},
				"size_bytes": {
					"minimum": 1,
					"type": "integer"
				}
			},
			"required": [
				"id",
				"repo_digest",
				"created_at",
				"size_bytes",
				"base_image",
				"platform",
				"configured_user",
				"oracle_runtime_user",
				"entrypoint",
				"cmd",
				"labels"
			],
			"type": "object"
		},
		"lock_id": {
			"pattern": "^pristine-runtime-v1-[a-f0-9]{64}$",
			"type": "string"
		},
		"lock_type": {
			"const": "pristine_runtime",
			"type": "string"
		},
		"provenance": {
			"additionalProperties": false,
			"properties": {
				"artifact_type": {
					"const": "repofixlab_pristine_harness",
					"type": "string"
				},
				"base_image": {
					"anyOf": [
						{
							"pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$",
							"type": "string"
						},
						{
							"pattern": "^sha256:[a-f0-9]{64}$",
							"type": "string"
						}
					]
				},
				"dependency_lock_sha256": {
					"const": "b836155987474285284c3b8228e8575dda5d4d3ae12e1bce049fc2894424cba9",
					"type": "string"
				},
				"dockerfile_sha256": {
					"pattern": "^[a-f0-9]{64}$",
					"type": "string"
				},
				"evaluator_kernel_aggregate_sha256": {
					"pattern": "^[a-f0-9]{64}$",
					"type": "string"
				},
				"evaluator_kernel_bytes": {
					"minimum": 1,
					"type": "integer"
				},
				"evaluator_kernel_file_count": {
					"minimum": 1,
					"type": "integer"
				},
				"platform": {
					"const": "linux/amd64",
					"type": "string"
				},
				"schema_version": {
					"const": "v1",
					"type": "string"
				},
				"sha256": {
					"pattern": "^[a-f0-9]{64}$",
					"type": "string"
				},
				"source_aggregate_sha256": {
					"const": "b8c8574e17fd0c11159c7fa3a63e17a247ca5b2f73fa0a9899ca542cfcb093e6",
					"type": "string"
				},
				"source_archive_sha256": {
					"pattern": "^[a-f0-9]{64}$",
					"type": "string"
				},
				"source_lock_file_sha256": {
					"const": "8b9ce8b01b58cbcfbef3a88e1b4cb99289553c948ccaa27afa83771ae5bb6741",
					"type": "string"
				},
				"source_lock_sha256": {
					"const": "f7e8a6e953d3351fd9c4dcea471222a277d55af7b5c25d384bda251b91c51a71",
					"type": "string"
				},
				"upstream_revision": {
					"const": "726c5461e2ef52d83cf1ea2107870a8bb3328d57",
					"type": "string"
				},
				"upstream_tree_sha1": {
					"const": "f178530b37202c549b1b2b3300db2da90da648db",
					"type": "string"
				}
			},
			"required": [
				"schema_version",
				"artifact_type",
				"platform",
				"base_image",
				"sha256",
				"source_archive_sha256",
				"source_lock_sha256",
				"source_lock_file_sha256",
				"source_aggregate_sha256",
				"upstream_revision",
				"upstream_tree_sha1",
				"dependency_lock_sha256",
				"evaluator_kernel_aggregate_sha256",
				"evaluator_kernel_file_count",
				"evaluator_kernel_bytes",
				"dockerfile_sha256"
			],
			"type": "object"
		},
		"schema_version": {
			"const": "v1",
			"type": "string"
		},
		"semantic_sha256": {
			"pattern": "^[a-f0-9]{64}$",
			"type": "string"
		},
		"verification": {
			"additionalProperties": false,
			"properties": {
				"build_time_self_check_passed": {
					"const": true,
					"type": "boolean"
				},
				"current_materials_bound": {
					"const": true,
					"type": "boolean"
				},
				"golden_oracle_resolved": {
					"const": true,
					"type": "boolean"
				},
				"golden_oracle_status_map_sha256": {
					"const": "00f69ade8e7237bb84f0d42c92c48fff1b4a7c4e37f3493804fbb978a0c9fbf0",
					"type": "string"
				},
				"restricted_runtime_self_check_passed": {
					"const": true,
					"type": "boolean"
				},
				"run_evaluation_import": {
					"const": "swebench/harness/run_evaluation.py",
					"type": "string"
				},
				"runtime_controls": {
					"additionalProperties": false,
					"properties": {
						"cap_drop": {
							"items": {
								"const": "ALL",
								"type": "string"
							},
							"maxItems": 1,
							"minItems": 1,
							"type": "array"
						},
						"cpus": {
							"const": 1,
							"type": "number"
						},
						"docker_socket": {
							"const": false,
							"type": "boolean"
						},
						"memory_bytes": {
							"const": 1073741824,
							"type": "number"
						},
						"network": {
							"const": "none",
							"type": "string"
						},
						"no_new_privileges": {
							"const": true,
							"type": "boolean"
						},
						"pids_limit": {
							"const": 128,
							"type": "number"
						},
						"published_ports": {
							"const": false,
							"type": "boolean"
						},
						"read_only_root": {
							"const": true,
							"type": "boolean"
						},
						"sensitive_environment": {
							"const": false,
							"type": "boolean"
						},
						"tmpfs": {
							"const": "/tmp:rw,noexec,nosuid,size=16m",
							"type": "string"
						}
					},
					"required": [
						"network",
						"read_only_root",
						"cap_drop",
						"no_new_privileges",
						"docker_socket",
						"published_ports",
						"sensitive_environment",
						"pids_limit",
						"memory_bytes",
						"cpus",
						"tmpfs"
					],
					"type": "object"
				}
			},
			"required": [
				"current_materials_bound",
				"build_time_self_check_passed",
				"restricted_runtime_self_check_passed",
				"run_evaluation_import",
				"golden_oracle_resolved",
				"golden_oracle_status_map_sha256",
				"runtime_controls"
			],
			"type": "object"
		}
	},
	"required": [
		"schema_version",
		"lock_type",
		"lock_id",
		"created_at",
		"image",
		"provenance",
		"verification",
		"semantic_sha256"
	],
	"type": "object"
}
